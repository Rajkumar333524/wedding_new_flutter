import 'dart:io';
import 'package:google_sign_in/google_sign_in.dart';
import 'package:googleapis/drive/v3.dart' as drive;
import 'package:http/io_client.dart';

class DriveService {
  static final _googleSignIn = GoogleSignIn(
    scopes: [drive.DriveApi.driveFileScope],
  );

  static Future<drive.DriveApi> getDriveApi() async {
    final account = await _googleSignIn.signIn();
    final authHeaders = await account!.authHeaders;
    final client = IOClient(
      HttpClient()..userAgent = 'wedding-register-app',
    );
    final authenticatedClient = _AuthenticatedClient(client, authHeaders);
    return drive.DriveApi(authenticatedClient);
  }
}

class _AuthenticatedClient extends IOClient {
  final Map<String, String> _headers;

  _AuthenticatedClient(super.client, this._headers);

  @override
  Future<StreamedResponse> send(BaseRequest request) {
    request.headers.addAll(_headers);
    return super.send(request);
  }
}
